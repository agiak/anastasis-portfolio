---
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';

---

<section id="contact" class="py-4 md:py-20 px-4 md:px-0">
  <div class="container mx-auto">
    <div class="contact-reveal opacity-0 space-y-12">
      
      <div class="mb-16">
        <h2 class="section-title">
            <span class="section-title__prompt">/</span>
            <span class="section-title__text">Contact Me</span>
          </h2>
        <p class="font-mono text-[10px] text-accent/60 tracking-widest uppercase mb-2">
          // hello@connect
        </p>
        <p class="text-gray font-body text-sm max-w-md">
          Feel free to reach out. I'm always open to discussing new projects and opportunities.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        {localData.socials.map((social) => (
          <a 
            href={social.url} 
            target="_blank" 
            class="group p-8 bg-container border border-line rounded-3xl hover:border-accent/45 hover:bg-surface transition-all duration-300"
          >
            <Icon 
              name={social.icon} 
              class="w-10 h-10 text-accent mb-4 mx-auto group-hover:scale-110 transition-transform" 
            />
            <h3 class="text-white font-bold mb-1">{social.name}</h3>
            <p class="text-gray-400 text-xs truncate px-2">
              {social.url
                .replace('https://', '')
                .replace('mailto:', '')
                .replace('tel:', '')
                .replace('wa.me/', '+')}
            </p>
          </a>
        ))}
        <div class="sm:col-span-2 lg:col-span-4 p-8 bg-container border border-accent/40 rounded-3xl hover:border-accent hover:bg-surface transition-all duration-300 flex flex-col lg:flex-row items-center gap-6 lg:text-left">
          <Icon
            name="mdi:briefcase-outline"
            class="w-10 h-10 text-accent shrink-0"
          />
          <div class="flex-1">
            <h3 class="text-white font-bold mb-1">Freelance &amp; Project Inquiries</h3>
            <p class="text-gray-400 text-xs leading-relaxed">
              Available for Android &amp; iOS mobile app development projects via AGcoding
            </p>
          </div>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              href="mailto:agcodinglp@gmail.com"
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-background border border-line rounded-lg text-xs text-accent font-mono tracking-wide hover:border-accent/50 transition-colors"
            >
              <Icon name="mdi:email-outline" class="w-4 h-4" aria-hidden="true" />
              agcodinglp@gmail.com
            </a>
            <a
              href="https://agcoding.gr"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-background border border-line rounded-lg text-xs text-accent font-mono tracking-wide hover:border-accent/50 transition-colors"
            >
              <Icon name="mdi:web" class="w-4 h-4" aria-hidden="true" />
              agcoding.gr
              <Icon name="mdi:open-in-new" class="w-3.5 h-3.5 opacity-60" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <!-- /* FOOTER */ -->
      <div class="pt-20 border-t border-line">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-gray-400 text-sm font-body order-2 md:order-1">
            {localData.name} © 2026
          </p>
          
          <div class="flex items-center gap-3 text-gray-400 text-xs font-body order-1 md:order-2">
            <span>Built with</span>
            <div class="flex gap-4">
              <a href="https://astro.build" target="_blank" class="hover:text-accent transition-colors flex items-center gap-1.5 group">
                <Icon name="skill-icons:astro" class="w-4 h-4 group-hover:drop-shadow-[0_0_5px_var(--color-accent)]" />
                <span>Astro</span>
              </a>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  .contact-reveal {
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .contact-reveal.reveal {
    opacity: 1 !important;
    transform: translateY(0);
  }
</style>

<script>
  const revealContact = () => {
    const section = document.querySelector('.contact-reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('reveal');
      });
    }, { threshold: 0.1 });
    if (section) observer.observe(section);
  }
  revealContact();
  document.addEventListener('astro:after-swap', revealContact);
</script>