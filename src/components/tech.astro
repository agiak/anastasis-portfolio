---
import { Icon } from 'astro-icon/components';
import localTechData from '../data/tech.json';

interface Skill {
  name: string;
  level: number;
  icon: string;
}

interface Category {
  title: string;
  skills: Skill[];
}

const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;
let categories: Category[];

try {
  if (BASE_URL) {
    const response = await fetch(`${BASE_URL}/tech`);
    const data = await response.json();
    categories = data.categories;
  } else {
    categories = localTechData.categories;
  }
} catch {
  categories = localTechData.categories;
}
---
<section id="tech" class="py-4 md:py-20 px-4 md:px-0 overflow-hidden">
  <div class="container mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <h2 class="section-title">
          <span class="section-title__prompt">/</span>
          <span class="section-title__text">Tech Stack</span>
        </h2>
        <p class="font-mono text-[10px] text-accent/60 tracking-widest uppercase mb-2">
          // skills.json
        </p>
        <p class="text-gray font-body text-sm max-w-md">
          Breakdown of my technical skills, categorized by domain and proficiency
        </p>
      </div>

      <div class="flex flex-wrap gap-2 p-3 rounded-2xl bg-container border border-line backdrop-blur-sm">
        {[
          { label: "Expert", level: 3 },
          { label: "Proficient", level: 2 },
          { label: "Beginner", level: 1 }
        ].map((item, index) => (
          <div class={`skill-legend-chip flex items-center gap-2 px-3 py-1.5 rounded-full border border-line bg-surface ${index > 0 ? 'md:border-l md:border-line md:pl-4 md:ml-1' : ''}`}>
            <div class="flex gap-0.5">
              {[1, 2, 3].map((star) => (
                <Icon 
                  name="mdi:star" 
                  class={`w-3 h-3 ${star <= item.level ? 'text-accent drop-shadow-[0_0_4px_rgba(61,220,132,0.45)]' : 'text-white/20'}`} 
                />
              ))}
            </div>
            <span class="text-[10px] uppercase tracking-wider text-gray font-mono">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-10">
      {categories.map((category) => (
        <div class="space-y-3">
          <h3 class="text-accent/90 font-mono text-[11px] uppercase tracking-[0.35em] ml-1">
            {category.title}
          </h3>
          
          <div class="flex flex-wrap gap-2 sm:gap-2.5">
            {category.skills.map((skill) => (
              <div class="skill-chip skill-card opacity-0 group inline-flex items-center gap-2 pl-2.5 pr-3 py-2 rounded-full border border-line bg-container shadow-sm hover:border-accent/50 hover:bg-surface hover:shadow-[0_0_20px_rgba(61,220,132,0.12)] transition-all duration-300">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface border border-line group-hover:border-accent/35 group-hover:bg-accent/10 transition-colors">
                  <Icon name={skill.icon} class="w-4 h-4 text-accent group-hover:scale-110 transition-transform" />
                </span>
                <span class="font-body text-white/95 text-[13px] font-medium tracking-tight max-w-[10rem] sm:max-w-none leading-tight">
                  {skill.name}
                </span>
                <span class="flex gap-0.5 border-l border-line ml-1 pl-2">
                  {[1, 2, 3].map((star) => (
                    <Icon 
                      name="mdi:circle" 
                      class={`w-1.5 h-1.5 ${
                        star <= skill.level 
                          ? 'text-accent drop-shadow-[0_0_3px_rgba(61,220,132,0.5)]' 
                          : 'text-white/15'
                      }`} 
                    />
                  ))}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-card {
    transform: translateY(12px) scale(0.98);
    transition: all 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .skill-card.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealSkills() {
    const cards = document.querySelectorAll('#tech .skill-card');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 8) * 40);
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.08,
      rootMargin: '0px 0px -40px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealSkills();
  document.addEventListener('astro:after-swap', revealSkills);
</script>
