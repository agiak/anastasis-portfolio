---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Home from "../components/home.astro";
import Tech from "../components/tech.astro";
import Projects from "../components/projects.astro";
import Contact from "../components/contact.astro";
import Career from "../components/career.astro";
import Certifications from "../components/certifications.astro";
import localData from '../data/home.json';

interface ProfileData {
  webpageTitle: string;
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData; // data as ProfileData

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    data = localData as ProfileData;
  }
} else {
  data = localData as ProfileData;
}

const { webpageTitle } = data;

const description =
  'Anastasis Giakoumatos is a Senior Mobile Engineer in Athens, Greece, specializing in Android. ' +
  '7 years building banking, payments and iGaming apps used by millions, shipped faster with AI.';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Anastasis Giakoumatos',
  jobTitle: 'Senior Mobile Engineer',
  description,
  url: Astro.site?.href,
  image: new URL('/og-image.jpg', Astro.site).href,
  email: 'mailto:anastas.giakoumatos@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Athens', addressCountry: 'GR' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Athens University of Economics and Business' },
  knowsAbout: ['Android', 'Kotlin', 'Jetpack Compose', 'Mobile Engineering', 'AI-assisted development', 'Claude Code'],
  sameAs: ['https://github.com/agiak', 'https://www.linkedin.com/in/anastasis-giakoumatos', 'https://agcoding.gr'],
};
---

<Layout title={webpageTitle} description={description} structuredData={person}>
  	<Nav />
	<Home />
	<Career />
	<Projects />
	<Tech />
	<Certifications />
	<Contact />
</Layout>
